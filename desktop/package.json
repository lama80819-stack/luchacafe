{
  "name": "tacos-enmascarados",
  "productName": "Tacos Enmascarados",
  "version": "1.7.0",
  "description": "Tacos Enmascarados: taquería de lucha libre. Cocina, atiende y decora tu changarro.",
  "author": "ACP PRODUCCION",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tucafe.luchacafe",
    "productName": "Tacos Enmascarados",
    "copyright": "© ACP PRODUCCION. Todos los derechos reservados.",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "package.json", "www/**/*"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TacosEnmascarados-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TacosEnmascarados-Portable-${version}.${ext}"
    }
  }
}
